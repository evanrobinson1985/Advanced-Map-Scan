<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Advanced Map Scan" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Public mound and effigy mound sites for training</name></metadata>
<wpt lat="43.0888" lon="-91.1856"><name>Effigy Mounds National Monument (IA)</name><desc>Effigy / linear: 200+ mounds: bear and bird effigies, linear and conical mounds; Marching Bear Group is in the South Unit. Best for: Effigy model + small conical mounds</desc><sym>Trail Head</sym></wpt>
<wpt lat="43.4633" lon="-88.1392"><name>Lizard Mound State Park (WI)</name><desc>Effigy / linear: Lizard/panther and bird effigies, linear and conical mounds. Best for: Effigy model + small conical mounds</desc><sym>Trail Head</sym></wpt>
<wpt lat="43.4886" lon="-89.6708"><name>Man Mound Park (WI)</name><desc>Effigy / linear: Human-figure effigy. Best for: Effigy model</desc><sym>Trail Head</sym></wpt>
<wpt lat="43.6014" lon="-89.7114"><name>Kingsley Bend Indian Mounds (WI)</name><desc>Effigy / linear: Effigy, linear and conical mounds. Best for: Effigy model + small conical mounds</desc><sym>Trail Head</sym></wpt>
<wpt lat="43.6958" lon="-87.7189"><name>Sheboygan Indian Mound Park (WI)</name><desc>Effigy / linear: Deer and panther (water spirit) effigies, linear and conical mounds. Best for: Effigy model + small conical mounds</desc><sym>Trail Head</sym></wpt>
<wpt lat="43.1019" lon="-89.3672"><name>Burrows Park Effigy Mound, Madison (WI)</name><desc>Effigy / linear: Bird effigy, 128 ft wingspan. Best for: Effigy model (bird)</desc><sym>Trail Head</sym></wpt>
<wpt lat="43.1350" lon="-89.4364"><name>Governor Nelson State Park (WI)</name><desc>Effigy / linear: Large panther effigy and conical mounds at the south end of the park (park coordinates). Best for: Effigy model + small conical mounds</desc><sym>Trail Head</sym></wpt>
<wpt lat="39.0264" lon="-83.4308"><name>Serpent Mound (OH)</name><desc>Effigy / linear: Serpent effigy, 1,348 ft long. Best for: Effigy model</desc><sym>Trail Head</sym></wpt>
<wpt lat="43.0656" lon="-88.8629"><name>Aztalan State Park (WI)</name><desc>Mound: 3 platform mounds and a line of conical mounds. Best for: Mound scan (platforms); small conicals for the mound model</desc><sym>Summit</sym></wpt>
<wpt lat="38.6603" lon="-90.0624"><name>Monks Mound, Cahokia (IL)</name><desc>Mound: Largest platform mound north of Mexico; ~70 other mounds in the site. Best for: Mound scan (platforms); too big for the mound model</desc><sym>Summit</sym></wpt>
<wpt lat="33.0047" lon="-87.6311"><name>Moundville Archaeological Site (AL)</name><desc>Mound: 29 platform mounds around a plaza. Best for: Mound scan (platforms)</desc><sym>Summit</sym></wpt>
<wpt lat="34.1251" lon="-84.8077"><name>Etowah Indian Mounds (GA)</name><desc>Mound: 6 mounds incl. 63 ft Mound A. Best for: Mound scan (platforms)</desc><sym>Summit</sym></wpt>
<wpt lat="32.8367" lon="-83.6083"><name>Ocmulgee Mounds NHP (GA)</name><desc>Mound: Great Temple Mound and other platform/burial mounds. Best for: Mound scan</desc><sym>Summit</sym></wpt>
<wpt lat="31.4686" lon="-84.9485"><name>Kolomoki Mounds State Park (GA)</name><desc>Mound: Platform mound and burial mounds. Best for: Mound scan</desc><sym>Summit</sym></wpt>
<wpt lat="34.6469" lon="-92.0653"><name>Plum Bayou (Toltec) Mounds (AR)</name><desc>Mound: Platform mounds around plazas. Best for: Mound scan</desc><sym>Summit</sym></wpt>
<wpt lat="32.6367" lon="-91.4114"><name>Poverty Point (LA)</name><desc>Mound: Huge Mound A, concentric ridges (linear earthworks) and smaller mounds. Best for: Mound scan; ridges for the effigy/linear model</desc><sym>Summit</sym></wpt>
<wpt lat="39.9169" lon="-80.7446"><name>Grave Creek Mound (WV)</name><desc>Mound: 62 ft conical burial mound. Best for: Mound scan (very large conical)</desc><sym>Summit</sym></wpt>
<wpt lat="39.6276" lon="-84.2809"><name>Miamisburg Mound (OH)</name><desc>Mound: 65 ft conical mound. Best for: Mound scan (very large conical)</desc><sym>Summit</sym></wpt>
<wpt lat="39.3741" lon="-83.0073"><name>Mound City Group, Hopewell Culture NHP (OH)</name><desc>Mound: 23 burial mounds inside an earthen enclosure. Best for: Mound model (small/medium mounds)</desc><sym>Summit</sym></wpt>
<wpt lat="35.4955" lon="-88.6825"><name>Pinson Mounds - Saul&#x27;s Mound (TN)</name><desc>Mound: 72 ft Saul&#x27;s Mound plus a dozen smaller mounds and an enclosure. Best for: Mound scan; smaller mounds for the mound model</desc><sym>Summit</sym></wpt>
<wpt lat="35.1414" lon="-88.3208"><name>Shiloh Indian Mounds (TN)</name><desc>Mound: 7 platform mounds and many small house mounds. Best for: Mound scan + mound model</desc><sym>Summit</sym></wpt>
<wpt lat="35.1824" lon="-79.9298"><name>Town Creek Indian Mound (NC)</name><desc>Mound: Reconstructed platform mound. Best for: Mound scan</desc><sym>Summit</sym></wpt>
<wpt lat="33.4858" lon="-91.0611"><name>Winterville Mounds (MS)</name><desc>Mound: 12+ platform mounds. Best for: Mound scan</desc><sym>Summit</sym></wpt>
<wpt lat="31.6361" lon="-91.2472"><name>Emerald Mound (MS)</name><desc>Mound: 35 ft platform mound with secondary mounds. Best for: Mound scan</desc><sym>Summit</sym></wpt>
<wpt lat="37.9425" lon="-87.4572"><name>Angel Mounds (IN)</name><desc>Mound: 11 platform mounds. Best for: Mound scan</desc><sym>Summit</sym></wpt>
<wpt lat="37.0806" lon="-88.4917"><name>Kincaid Mounds (IL)</name><desc>Mound: Platform and burial mounds. Best for: Mound scan</desc><sym>Summit</sym></wpt>
<wpt lat="44.9456" lon="-93.0536"><name>Indian Mounds Regional Park, St. Paul (MN)</name><desc>Mound: 6 conical burial mounds on the bluff. Best for: Mound model (conical)</desc><sym>Summit</sym></wpt>
</gpx>